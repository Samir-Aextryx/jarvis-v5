# Microsoft Planner: app-only, Graph GET only.
# Entra application permission Tasks.Read.All requires administrator consent.
# The server moves CLIENT_SECRET into Windows Credential Manager on start and
# removes it from .env; PlannerConfig.from_env() falls back to the vault.
TENANT_ID=00000000-0000-0000-0000-000000000000
PLAN_ID=your-planner-plan-id
CLIENT_ID=
CLIENT_SECRET=
